<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Menedżer linków</title>
  <style>
    :root {
      --bg1: #0f172a;
      --bg2: #1e293b;
      --card: rgba(255,255,255,0.08);
      --card-border: rgba(255,255,255,0.12);
      --text: #f8fafc;
      --muted: #94a3b8;
      --accent: #3b82f6;
      --accent2: #60a5fa;
      --danger: #ef4444;
      --warn: #f59e0b;
      --ok: #22c55e;
      --shadow: 0 10px 30px rgba(0,0,0,0.25);
      --radius: 20px;
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background:
        radial-gradient(circle at top, rgba(96,165,250,0.25), transparent 30%),
        linear-gradient(180deg, var(--bg2), var(--bg1));
      color: var(--text);
      min-height: 100%;
    }

    body {
      padding: 14px;
    }

    .app {
      max-width: 720px;
      margin: 0 auto;
    }

    .topbar {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 16px;
    }

    .title {
      font-size: 32px;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin: 8px 4px 0;
    }

    .toolbar {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
      background: rgba(15, 23, 42, 0.5);
      border: 1px solid var(--card-border);
      border-radius: 22px;
      padding: 12px;
      backdrop-filter: blur(12px);
      box-shadow: var(--shadow);
    }

    .search {
      width: 100%;
      border: none;
      outline: none;
      border-radius: 16px;
      padding: 14px 16px;
      font-size: 16px;
      background: rgba(255,255,255,0.08);
      color: white;
      border: 1px solid rgba(255,255,255,0.08);
    }

    .search::placeholder {
      color: #cbd5e1;
    }

    .row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    button, select {
      border: none;
      border-radius: 16px;
      padding: 12px 14px;
      font-size: 15px;
      font-weight: 700;
    }

    button {
      color: white;
      background: linear-gradient(180deg, var(--accent2), var(--accent));
      box-shadow: 0 6px 18px rgba(59,130,246,0.35);
    }

    button.secondary {
      background: rgba(255,255,255,0.12);
      box-shadow: none;
    }

    button.danger {
      background: linear-gradient(180deg, #f87171, var(--danger));
      box-shadow: 0 6px 18px rgba(239,68,68,0.28);
    }

    button.warn {
      background: linear-gradient(180deg, #fbbf24, var(--warn));
      box-shadow: 0 6px 18px rgba(245,158,11,0.28);
    }

    button.ghost {
      background: transparent;
      border: 1px solid rgba(255,255,255,0.14);
      box-shadow: none;
    }

    .group-tabs {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      padding: 4px 2px 2px;
      scrollbar-width: none;
    }

    .group-tabs::-webkit-scrollbar {
      display: none;
    }

    .group-tab {
      flex: 0 0 auto;
      background: rgba(255,255,255,0.09);
      color: white;
      border: 1px solid rgba(255,255,255,0.12);
      padding: 10px 16px;
      border-radius: 999px;
      font-size: 15px;
      font-weight: 700;
      box-shadow: none;
    }

    .group-tab.active {
      background: linear-gradient(180deg, #60a5fa, #2563eb);
      box-shadow: 0 6px 18px rgba(59,130,246,0.35);
    }

    .panel {
      background: rgba(15,23,42,0.55);
      border: 1px solid var(--card-border);
      border-radius: 26px;
      padding: 14px;
      backdrop-filter: blur(14px);
      box-shadow: var(--shadow);
    }

    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 12px;
    }

    .section-title {
      font-size: 22px;
      font-weight: 800;
      margin: 0;
    }

    .section-sub {
      color: var(--muted);
      font-size: 14px;
      margin-top: 4px;
    }

    .link-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      min-height: 20px;
    }

    .link-item {
      position: relative;
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
      border-radius: 18px;
      padding: 14px 14px;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.10);
      transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease;
      user-select: none;
      touch-action: manipulation;
    }

    .link-item:active {
      transform: scale(0.995);
    }

    .link-item.dragging {
      opacity: 0.55;
      transform: scale(1.01);
      border-color: #93c5fd;
    }

    .link-main {
      flex: 1;
      min-width: 0;
      cursor: pointer;
    }

    .link-title {
      font-size: 18px;
      font-weight: 750;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .link-meta-hidden {
      display: none;
    }

    .menu-wrap {
      position: relative;
      flex: 0 0 auto;
    }

    .menu-btn {
      width: 42px;
      height: 42px;
      border-radius: 14px;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.10);
      box-shadow: none;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      font-size: 22px;
      line-height: 1;
    }

    .menu-btn span {
      transform: translateY(-1px);
      letter-spacing: 1px;
    }

    .dropdown {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      width: 190px;
      background: #172033;
      border: 1px solid rgba(255,255,255,0.10);
      border-radius: 16px;
      box-shadow: 0 18px 35px rgba(0,0,0,0.35);
      overflow: hidden;
      display: none;
      z-index: 40;
    }

    .dropdown.open {
      display: block;
    }

    .dropdown button {
      width: 100%;
      text-align: left;
      background: transparent;
      box-shadow: none;
      border-radius: 0;
      padding: 14px 16px;
      font-weight: 650;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .dropdown button:last-child {
      border-bottom: none;
    }

    .dropdown button:hover,
    .dropdown button:active {
      background: rgba(255,255,255,0.08);
    }

    .empty {
      color: var(--muted);
      text-align: center;
      padding: 18px 10px;
      font-size: 15px;
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(2,6,23,0.6);
      backdrop-filter: blur(4px);
      display: none;
      align-items: flex-end;
      justify-content: center;
      z-index: 100;
    }

    .modal-backdrop.show {
      display: flex;
    }

    .modal {
      width: 100%;
      max-width: 720px;
      background: #111827;
      border-radius: 24px 24px 0 0;
      padding: 18px 16px 22px;
      border: 1px solid rgba(255,255,255,0.08);
      box-shadow: 0 -10px 40px rgba(0,0,0,0.35);
    }

    .modal h3 {
      margin: 4px 0 14px;
      font-size: 22px;
    }

    .modal .field {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 12px;
    }

    .modal label {
      color: #cbd5e1;
      font-size: 14px;
      font-weight: 600;
    }

    .modal input,
    .modal select,
    .modal textarea {
      width: 100%;
      border: 1px solid rgba(255,255,255,0.08);
      background: rgba(255,255,255,0.06);
      color: white;
      border-radius: 14px;
      padding: 13px 14px;
      font-size: 16px;
      outline: none;
    }

    .modal textarea {
      min-height: 90px;
      resize: vertical;
    }

    .modal-actions {
      display: flex;
      gap: 10px;
      margin-top: 12px;
    }

    .modal-actions button {
      flex: 1;
    }

    .hint {
      font-size: 13px;
      color: var(--muted);
      margin-top: 4px;
    }

    .footer-note {
      color: var(--muted);
      font-size: 13px;
      text-align: center;
      padding: 12px 8px 0;
    }

    @media (min-width: 768px) {
      body {
        padding: 22px;
      }

      .toolbar {
        grid-template-columns: 1fr auto;
        align-items: center;
      }

      .toolbar .full {
        grid-column: 1 / -1;
      }

      .modal-backdrop {
        align-items: center;
      }

      .modal {
        border-radius: 24px;
      }
    }
  </style>
</head>
<body>
  <div class="app">
    <div class="topbar">
      <div class="title">Moje linki</div>

      <div class="group-tabs" id="groupTabs"></div>

      <div class="toolbar">
        <input id="searchInput" class="search full" type="text" placeholder="Szukaj tytułu linku..." />
        <div class="row">
          <button id="addLinkBtn">Dodaj link</button>
          <button id="addGroupBtn" class="secondary">Dodaj grupę</button>
          <button id="renameGroupBtn" class="secondary">Zmień nazwę grupy</button>
          <button id="deleteGroupBtn" class="danger">Usuń grupę</button>
        </div>
      </div>
    </div>

    <div class="panel">
      <div class="section-header">
        <div>
          <div class="section-title" id="currentGroupTitle">Grupa</div>
          <div class="section-sub" id="currentGroupCount">0 linków</div>
        </div>
      </div>

      <div class="link-list" id="linkList"></div>
      <div class="footer-note">Kliknij link, aby otworzyć. Przytrzymaj dłużej, aby zmienić kolejność.</div>
    </div>
  </div>

  <div class="modal-backdrop" id="modalBackdrop">
    <div class="modal" id="modalContent"></div>
  </div>

  <script>
    const STORAGE_KEY = 'mobile_links_manager_v1';

    const defaultData = {
      groups: [
        {
          id: crypto.randomUUID(),
          name: 'Ogólne',
          links: [
            {
              id: crypto.randomUUID(),
              title: 'Lista uczniów',
              url: 'https://example.com'
            },
            {
              id: crypto.randomUUID(),
              title: 'Dzwonki',
              url: 'https://example.org'
            }
          ]
        }
      ],
      currentGroupId: null
    };

    let state = loadState();
    if (!state.currentGroupId && state.groups.length) {
      state.currentGroupId = state.groups[0].id;
    }

    const groupTabs = document.getElementById('groupTabs');
    const linkList = document.getElementById('linkList');
    const currentGroupTitle = document.getElementById('currentGroupTitle');
    const currentGroupCount = document.getElementById('currentGroupCount');
    const searchInput = document.getElementById('searchInput');
    const modalBackdrop = document.getElementById('modalBackdrop');
    const modalContent = document.getElementById('modalContent');

    document.getElementById('addLinkBtn').addEventListener('click', openAddLinkModal);
    document.getElementById('addGroupBtn').addEventListener('click', addGroup);
    document.getElementById('renameGroupBtn').addEventListener('click', renameCurrentGroup);
    document.getElementById('deleteGroupBtn').addEventListener('click', deleteCurrentGroup);
    searchInput.addEventListener('input', render);

    modalBackdrop.addEventListener('click', (e) => {
      if (e.target === modalBackdrop) closeModal();
    });

    document.addEventListener('click', (e) => {
      if (!e.target.closest('.menu-wrap')) {
        closeAllMenus();
      }
    });

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return structuredClone(defaultData);
        const parsed = JSON.parse(raw);

        if (!parsed.groups || !Array.isArray(parsed.groups) || parsed.groups.length === 0) {
          return structuredClone(defaultData);
        }

        parsed.groups.forEach(group => {
          if (!Array.isArray(group.links)) group.links = [];
        });

        return parsed;
      } catch {
        return structuredClone(defaultData);
      }
    }

    function saveState() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    }

    function getCurrentGroup() {
      return state.groups.find(g => g.id === state.currentGroupId) || state.groups[0];
    }

    function render() {
      renderTabs();
      renderLinks();
      saveState();
    }

    function renderTabs() {
      groupTabs.innerHTML = '';

      state.groups.forEach(group => {
        const btn = document.createElement('button');
        btn.className = 'group-tab' + (group.id === state.currentGroupId ? ' active' : '');
        btn.textContent = group.name;
        btn.addEventListener('click', () => {
          state.currentGroupId = group.id;
          render();
        });
        groupTabs.appendChild(btn);
      });
    }

    function renderLinks() {
      const group = getCurrentGroup();
      currentGroupTitle.textContent = group?.name || 'Grupa';

      const query = searchInput.value.trim().toLowerCase();
      const links = (group?.links || []).filter(link =>
        link.title.toLowerCase().includes(query)
      );

      currentGroupCount.textContent = `${links.length} linków`;
      linkList.innerHTML = '';

      if (!links.length) {
        const empty = document.createElement('div');
        empty.className = 'empty';
        empty.textContent = query ? 'Brak wyników.' : 'Brak linków w tej grupie.';
        linkList.appendChild(empty);
        return;
      }

      links.forEach((link) => {
        const item = document.createElement('div');
        item.className = 'link-item';
        item.draggable = true;
        item.dataset.id = link.id;

        const main = document.createElement('div');
        main.className = 'link-main';

        const title = document.createElement('div');
        title.className = 'link-title';
        title.textContent = link.title;

        const hiddenMeta = document.createElement('div');
        hiddenMeta.className = 'link-meta-hidden';
        hiddenMeta.textContent = link.url;

        main.appendChild(title);
        main.appendChild(hiddenMeta);

        let longPressTimer = null;
        let longPressTriggered = false;

        const startPress = () => {
          longPressTriggered = false;
          longPressTimer = setTimeout(() => {
            longPressTriggered = true;
            item.draggable = true;
            item.classList.add('dragging');
            if (navigator.vibrate) navigator.vibrate(30);
          }, 350);
        };

        const cancelPress = () => {
          clearTimeout(longPressTimer);
        };

        main.addEventListener('touchstart', startPress, { passive: true });
        main.addEventListener('touchend', cancelPress);
        main.addEventListener('touchmove', cancelPress);
        main.addEventListener('mousedown', startPress);
        main.addEventListener('mouseup', cancelPress);
        main.addEventListener('mouseleave', cancelPress);

        main.addEventListener('click', (e) => {
          if (longPressTriggered) {
            e.preventDefault();
            return;
          }
          window.open(link.url, '_blank', 'noopener,noreferrer');
        });

        const menuWrap = document.createElement('div');
        menuWrap.className = 'menu-wrap';

        const menuBtn = document.createElement('button');
        menuBtn.className = 'menu-btn';
        menuBtn.setAttribute('aria-label', 'Menu');
        menuBtn.innerHTML = '<span>⋯</span>';

        const dropdown = document.createElement('div');
        dropdown.className = 'dropdown';

        const moveBtn = document.createElement('button');
        moveBtn.textContent = 'Przenieś do grupy';
        moveBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          closeAllMenus();
          moveLinkToGroup(link.id);
        });

        const editBtn = document.createElement('button');
        editBtn.textContent = 'Edytuj';
        editBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          closeAllMenus();
          openEditLinkModal(link.id);
        });

        const deleteBtn = document.createElement('button');
        deleteBtn.textContent = 'Usuń';
        deleteBtn.style.color = '#fca5a5';
        deleteBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          closeAllMenus();
          deleteLink(link.id);
        });

        dropdown.appendChild(moveBtn);
        dropdown.appendChild(editBtn);
        dropdown.appendChild(deleteBtn);

        menuBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = dropdown.classList.contains('open');
          closeAllMenus();
          if (!isOpen) dropdown.classList.add('open');
        });

        menuWrap.appendChild(menuBtn);
        menuWrap.appendChild(dropdown);

        item.appendChild(main);
        item.appendChild(menuWrap);

        addDragHandlers(item, link.id);

        linkList.appendChild(item);
      });
    }

    function closeAllMenus() {
      document.querySelectorAll('.dropdown.open').forEach(el => el.classList.remove('open'));
    }

    function openModal(html) {
      modalContent.innerHTML = html;
      modalBackdrop.classList.add('show');
    }

    function closeModal() {
      modalBackdrop.classList.remove('show');
      modalContent.innerHTML = '';
    }

    function openAddLinkModal() {
      const currentGroup = getCurrentGroup();
      openModal(`
        <h3>Dodaj link</h3>
        <div class="field">
          <label for="linkTitle">Tytuł</label>
          <input id="linkTitle" type="text" placeholder="Np. Lista uczniów" />
        </div>
        <div class="field">
          <label for="linkUrl">Adres URL</label>
          <input id="linkUrl" type="url" placeholder="https://..." />
        </div>
        <div class="field">
          <label for="linkGroup">Grupa</label>
          <select id="linkGroup">
            ${state.groups.map(g => `
              <option value="${g.id}" ${g.id === currentGroup.id ? 'selected' : ''}>${escapeHtml(g.name)}</option>
            `).join('')}
          </select>
        </div>
        <div class="modal-actions">
          <button class="secondary" id="cancelModalBtn">Anuluj</button>
          <button id="saveLinkBtn">Zapisz</button>
        </div>
      `);

      document.getElementById('cancelModalBtn').addEventListener('click', closeModal);
      document.getElementById('saveLinkBtn').addEventListener('click', () => {
        const title = document.getElementById('linkTitle').value.trim();
        const url = document.getElementById('linkUrl').value.trim();
        const groupId = document.getElementById('linkGroup').value;

        if (!title || !url) {
          alert('Uzupełnij tytuł i adres URL.');
          return;
        }

        const validUrl = normalizeUrl(url);
        if (!validUrl) {
          alert('Podaj poprawny adres URL.');
          return;
        }

        const group = state.groups.find(g => g.id === groupId);
        if (!group) return;

        group.links.push({
          id: crypto.randomUUID(),
          title,
          url: validUrl
        });

        state.currentGroupId = group.id;
        closeModal();
        render();
      });
    }

    function openEditLinkModal(linkId) {
      const found = findLinkById(linkId);
      if (!found) return;

      openModal(`
        <h3>Edytuj link</h3>
        <div class="field">
          <label for="editLinkTitle">Tytuł</label>
          <input id="editLinkTitle" type="text" value="${escapeHtmlAttr(found.link.title)}" />
        </div>
        <div class="field">
          <label for="editLinkUrl">Adres URL</label>
          <input id="editLinkUrl" type="url" value="${escapeHtmlAttr(found.link.url)}" />
        </div>
        <div class="field">
          <label for="editLinkGroup">Grupa</label>
          <select id="editLinkGroup">
            ${state.groups.map(g => `
              <option value="${g.id}" ${g.id === found.group.id ? 'selected' : ''}>${escapeHtml(g.name)}</option>
            `).join('')}
          </select>
        </div>
        <div class="modal-actions">
          <button class="secondary" id="cancelEditBtn">Anuluj</button>
          <button id="saveEditBtn">Zapisz zmiany</button>
        </div>
      `);

      document.getElementById('cancelEditBtn').addEventListener('click', closeModal);
      document.getElementById('saveEditBtn').addEventListener('click', () => {
        const title = document.getElementById('editLinkTitle').value.trim();
        const url = document.getElementById('editLinkUrl').value.trim();
        const newGroupId = document.getElementById('editLinkGroup').value;

        if (!title || !url) {
          alert('Uzupełnij tytuł i adres URL.');
          return;
        }

        const validUrl = normalizeUrl(url);
        if (!validUrl) {
          alert('Podaj poprawny adres URL.');
          return;
        }

        found.link.title = title;
        found.link.url = validUrl;

        if (newGroupId !== found.group.id) {
          found.group.links = found.group.links.filter(l => l.id !== found.link.id);
          const newGroup = state.groups.find(g => g.id === newGroupId);
          if (newGroup) {
            newGroup.links.push(found.link);
            state.currentGroupId = newGroup.id;
          }
        }

        closeModal();
        render();
      });
    }

    function addGroup() {
      const name = prompt('Podaj nazwę nowej grupy:');
      if (!name || !name.trim()) return;

      const group = {
        id: crypto.randomUUID(),
        name: name.trim(),
        links: []
      };

      state.groups.push(group);
      state.currentGroupId = group.id;
      render();
    }

    function renameCurrentGroup() {
      const group = getCurrentGroup();
      if (!group) return;

      const name = prompt('Nowa nazwa grupy:', group.name);
      if (!name || !name.trim()) return;

      group.name = name.trim();
      render();
    }

    function deleteCurrentGroup() {
      if (state.groups.length <= 1) {
        alert('Musi pozostać przynajmniej jedna grupa.');
        return;
      }

      const group = getCurrentGroup();
      if (!group) return;

      const ok = confirm(`Usunąć grupę "${group.name}" razem z linkami?`);
      if (!ok) return;

      state.groups = state.groups.filter(g => g.id !== group.id);
      state.currentGroupId = state.groups[0].id;
      render();
    }

    function deleteLink(linkId) {
      const found = findLinkById(linkId);
      if (!found) return;

      const ok = confirm(`Usunąć link "${found.link.title}"?`);
      if (!ok) return;

      found.group.links = found.group.links.filter(l => l.id !== linkId);
      render();
    }

    function moveLinkToGroup(linkId) {
      const found = findLinkById(linkId);
      if (!found) return;

      const targetGroups = state.groups.filter(g => g.id !== found.group.id);
      if (!targetGroups.length) {
        alert('Nie ma innej grupy, do której można przenieść link.');
        return;
      }

      openModal(`
        <h3>Przenieś do grupy</h3>
        <div class="field">
          <label for="moveTargetGroup">Wybierz grupę</label>
          <select id="moveTargetGroup">
            ${targetGroups.map(g => `<option value="${g.id}">${escapeHtml(g.name)}</option>`).join('')}
          </select>
        </div>
        <div class="modal-actions">
          <button class="secondary" id="cancelMoveBtn">Anuluj</button>
          <button id="confirmMoveBtn">Przenieś</button>
        </div>
      `);

      document.getElementById('cancelMoveBtn').addEventListener('click', closeModal);
      document.getElementById('confirmMoveBtn').addEventListener('click', () => {
        const targetId = document.getElementById('moveTargetGroup').value;
        const targetGroup = state.groups.find(g => g.id === targetId);
        if (!targetGroup) return;

        found.group.links = found.group.links.filter(l => l.id !== found.link.id);
        targetGroup.links.push(found.link);
        closeModal();
        render();
      });
    }

    function findLinkById(linkId) {
      for (const group of state.groups) {
        const link = group.links.find(l => l.id === linkId);
        if (link) return { group, link };
      }
      return null;
    }

    function normalizeUrl(url) {
      try {
        const prepared = /^(https?:)?\/\//i.test(url) ? url : `https://${url}`;
        return new URL(prepared).href;
      } catch {
        return null;
      }
    }

    function escapeHtml(str) {
      return String(str)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }

    function escapeHtmlAttr(str) {
      return escapeHtml(str);
    }

    let draggedId = null;

    function addDragHandlers(item, linkId) {
      item.addEventListener('dragstart', (e) => {
        draggedId = linkId;
        item.classList.add('dragging');
        e.dataTransfer.effectAllowed = 'move';
        try {
          e.dataTransfer.setData('text/plain', linkId);
        } catch {}
      });

      item.addEventListener('dragend', () => {
        item.classList.remove('dragging');
        document.querySelectorAll('.link-item').forEach(el => el.classList.remove('dragging'));
      });

      item.addEventListener('dragover', (e) => {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
      });

      item.addEventListener('drop', (e) => {
        e.preventDefault();
        const targetId = linkId;
        if (!draggedId || draggedId === targetId) return;

        const group = getCurrentGroup();
        const fromIndex = group.links.findIndex(l => l.id === draggedId);
        const toIndex = group.links.findIndex(l => l.id === targetId);

        if (fromIndex === -1 || toIndex === -1) return;

        const [moved] = group.links.splice(fromIndex, 1);
        group.links.splice(toIndex, 0, moved);

        draggedId = null;
        render();
      });
    }

    render();
  </script>
</body>
</html>
